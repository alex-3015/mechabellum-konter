{
  "name": "mechabellum-konter",
  "version": "1.0.0",
  "private": true,
  "description": "Cheat-Sheet für Mechabellum: welche Einheit kontert welche, mit Tech-Schaltern aus den Spieldateien",
  "author": "Alex (alex-3015)",
  "license": "MIT",
  "repository": "github:alex-3015/mechabellum-konter",
  "scripts": {
    "check": "node scripts/check-i18n.js",
    "build": "node scripts/build.js",
    "techs": "node scripts/gentechs.js",
    "icons": "node scripts/icons.js",
    "all": "npm run icons && npm run techs && npm run build",
    "dev": "node -e \"process.env.ALLOW_MISSING=1;require('./scripts/build.js')\"",
    "serve": "node scripts/serve.js index.html",
    "extract:texts": "node scripts/extract/gametexts.js \"C:/Program Files (x86)/Steam/steamapps/common/Mechabellum/Mechabellum_Data/resources.assets\" data/gametexts.json"
  }
}
